# Hollaback configuration. Copy to .env (repo root) and fill in what you have.
# Everything is optional: with no values the server runs in mock mode with an
# in-memory store, a console "WhatsApp" channel and the scripted agent.

# ---------------------------------------------------------------- PayPal
# Leave empty to auto-select mock mode when credentials are missing.
# 1 forces the in-process fake of Orders v2 / Invoicing v2 / Webhooks (pnpm dev:mock sets it).
MOCK_PAYPAL=
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `pnpm paypal:webhook`. Required to verify webhook signatures.
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_ENVIRONMENT=sandbox

# ---------------------------------------------------------------- Server
PORT=4000
HOST=0.0.0.0
# Public base URL of the server. Must be HTTPS when deployed (webhooks, Twilio signatures).
# On Render it defaults to RENDER_EXTERNAL_URL.
SERVER_PUBLIC_URL=http://localhost:4000
# Used for the PayPal return_url / cancel_url (return.html, cancel.html).
DEMO_STORE_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:3000
# Comma-separated allowed origins. Empty reflects any origin (fine for the demo).
CORS_ORIGINS=
LOG_LEVEL=info
# Override the path to the built snippet (defaults to snippet/dist/hb.js).
SNIPPET_PATH=

# ---------------------------------------------------------------- Abandonment
# Grace period after a PayPal order is created before its status is checked.
GRACE_MS=30000
# Delay before confirming a cancelled PayPal popup.
ABANDON_SETTLE_MS=3000
# Flag an order as abandoned after this long even without a browser signal.
ABANDON_MAX_WAIT_MS=600000
# One follow-up nudge after this long without a reply (0 disables). Two unanswered messages end the chat.
FOLLOW_UP_MS=900000
# Agent discount cap in percent. Hard ceiling of 10 regardless of this value.
DISCOUNT_CAP_PCT=10

# ---------------------------------------------------------------- Merchant
MERCHANT_ID=demo
MERCHANT_NAME=Kicks Lagos
MERCHANT_CURRENCY=USD
MERCHANT_PERSONA=

# ---------------------------------------------------------------- Agent
# With a key the Claude agent runs; without one the scripted agent runs.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# auto | claude | scripted
AGENT_MODE=auto

# ---------------------------------------------------------------- WhatsApp (Twilio sandbox)
# With all three set, messages go to WhatsApp; otherwise they print in the server console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Validate X-Twilio-Signature on /whatsapp/inbound (needs SERVER_PUBLIC_URL to match Twilio's URL).
TWILIO_VALIDATE_SIGNATURE=1

# ---------------------------------------------------------------- Supabase
# With both set, data persists in Supabase (run supabase/schema.sql first); otherwise in memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Front ends
# Dashboard (Next.js reads NEXT_PUBLIC_* at build time; put it in dashboard/.env.local or the host's env).
NEXT_PUBLIC_HOLLABACK_API_URL=http://localhost:4000
# Demo store server/build and the demo:mock script.
HOLLABACK_API_URL=http://localhost:4000
STORE_PORT=5173
